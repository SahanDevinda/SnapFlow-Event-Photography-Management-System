# ==========================================
# SNAPFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Backend Configuration (Microsoft SQL Server)
# Use the same server name / instance and credentials you connect with in SSMS.
# The "snapflow_db" database must already exist - create it once in SSMS
# (right-click Databases > New Database) before the app's first run, since
# SQL Server has no equivalent of MySQL's createDatabaseIfNotExist.
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=snapflow_db;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=your_sql_server_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Directory
FILE_UPLOAD_DIR=./uploads

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
